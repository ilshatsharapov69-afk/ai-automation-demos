# stub (offline, free) | ollama (local, free) | workers-ai (Cloudflare free allowance) | openai (any OpenAI-compatible API) | anthropic
LLM_PROVIDER=stub
# Model name for the chosen provider (examples: llama3.1:8b for Ollama, @cf/meta/llama-3.1-8b-instruct for Workers AI)
LLM_MODEL=
# Ollama
OLLAMA_URL=http://localhost:11434/v1
# OpenAI-compatible services (OpenRouter, Groq, DeepSeek, OpenAI, LM Studio…)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Anthropic: the SDK reads ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
# Knowledge base and the "hand off to a human" threshold (0..1; empty = 0.55 for stub, 0.35 for LLMs)
FAQ_PATH=faq.json
MIN_CONFIDENCE=
# Telegram front-end: python -m faqbot --telegram
BOT_TOKEN=
ADMIN_CHAT_ID=
