# memory | amocrm | bitrix24   (memory = just log leads, no account needed)
CRM=memory
# Shared secret: the sender must call /webhook/<source>?token=<WEBHOOK_SECRET> or send X-Webhook-Token
WEBHOOK_SECRET=change-me
PORT=8000

# amoCRM / Kommo
AMO_BASE_URL=https://yoursubdomain.amocrm.ru
AMO_TOKEN=
AMO_PIPELINE_ID=
AMO_STATUS_ID=

# Bitrix24 inbound webhook URL (scope: crm)
BITRIX_WEBHOOK_URL=https://yourportal.bitrix24.ru/rest/1/xxxxxxxx/

# Optional Telegram notification for every lead
TG_BOT_TOKEN=
TG_CHAT_ID=
