# Telegram token from @BotFather
BOT_TOKEN=123456:ABC...
# Spreadsheet id: the long part of https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Leave empty to write to leads.csv instead (handy for a first local run).
SHEET_ID=
WORKSHEET=Leads
# Path to the service-account JSON key (see README, "Google service account")
GOOGLE_CREDENTIALS=service_account.json
# Chat id that receives a copy of every request (optional; get it from @userinfobot)
ADMIN_CHAT_ID=
# Time zone for the "Date" column, IANA name
TZ_NAME=UTC
